# Copy to .env and fill in YOUTUBE_API_KEY. The service loads .env automatically
# from the working directory or a parent; real environment variables override it.

# ---- app ----
APP_ENV=development           # development | staging | production
HTTP_ADDR=:8080
LOG_LEVEL=info                # debug | info | warn | error
DOCS_ENABLED=true             # serves Swagger UI at /docs and the spec at /openapi.yaml

# ---- timeouts (duration strings, or bare seconds) ----
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s
UPSTREAM_TIMEOUT=8s
CACHE_TTL=60s                 # 0 disables the in-process cache

# ---- database (required) ----
# The dashboard stores users, tracked videos and the metric time series here.
# `make db-up` starts a matching postgres in docker; `make migrate` applies the
# schema. Migrations also run at boot unless MIGRATE_ON_BOOT=false.
DATABASE_URL=postgres://socialstats:socialstats@localhost:5434/socialstats?sslmode=disable
DATABASE_MAX_CONNS=10         # per replica; postgres' own limit is 100 by default
DATABASE_MIN_CONNS=2          # kept warm so the first request skips the handshake
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONNECT_TIMEOUT=5s
MIGRATE_ON_BOOT=true          # false where migrations are a separate deploy step
                              # (`socialstats -migrate-only` runs them)

# ---- auth ----
SESSION_TTL=720h              # 30 days absolute
SESSION_IDLE_TTL=168h         # 7 days without activity
SESSION_TOUCH_INTERVAL=5m     # how stale last-seen gets before a request rewrites it
SESSION_COOKIE_NAME=ss_session
SESSION_COOKIE_SECURE=true    # forced false when APP_ENV=development, because a
                              # Secure cookie is never sent over http
# SESSION_COOKIE_DOMAIN=      # empty for a host-only cookie
REGISTRATION_OPEN=true        # false makes sign-up admin-only

LOGIN_ATTEMPTS=5              # burst allowance, per email AND per IP
LOGIN_WINDOW=15m              # how long a full bucket takes to refill from empty

# argon2id cost. Raising these does not invalidate existing accounts: a hash
# carries the parameters it was made with, and the next successful login
# upgrades it. ARGON2_CONCURRENCY caps the memory a burst of sign-ins can hold —
# at these defaults, 4 x 64 MiB = 256 MiB. Size the container accordingly.
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_THREADS=4
ARGON2_CONCURRENCY=4

# Only turn this on when a reverse proxy really is in front. With it on and no
# proxy, any caller can set X-Forwarded-For and choose which rate limit bucket
# to spend, which is the same as turning the per-IP limit off.
TRUST_PROXY_HEADERS=false

# ---- lookup ----
LOOKUP_TIMEOUT=30s            # bounds one lookup, including the provider call
LOOKUP_HISTORY_LIMIT=100      # how many past lookups the dashboard lists

# ---- youtube (required) ----
# console.cloud.google.com -> enable "YouTube Data API v3" -> create an API key
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3

# ---- meta: facebook + instagram ----
# Meta has no public API for arbitrary video URLs, so counters come from the
# public pages: Instagram from its login-free embed render, Facebook from the
# Relay payload on the public video page. No credentials needed for that path.
# See internal/provider/meta.
META_ENABLED=true
META_PAGE_FETCH=true          # false leaves only the Graph API path below,
                              # which disables Instagram entirely
META_MAX_ATTEMPTS=3
META_RETRY_BACKOFF=1s
# META_USER_AGENT=            # override only if the default stops working

# An access token is optional. It only unlocks the Graph API path, which serves
# Facebook videos the token's app administers (your own Pages) — there is no
# public-data tier for third-party metrics. Everything else uses the page path.
META_ACCESS_TOKEN=
META_API_BASE_URL=https://graph.facebook.com
META_API_VERSION=v21.0

# ---- tiktok ----
# TikTok has no API for arbitrary video URLs, so counters are read from the
# public video page. No credentials needed. See internal/provider/tiktok.
TIKTOK_ENABLED=true
TIKTOK_BASE_URL=https://www.tiktok.com
TIKTOK_MAX_ATTEMPTS=4         # TikTok challenges ~1/3 of requests; retries fix most
TIKTOK_RETRY_BACKOFF=1s       # keep >=1s: faster retries trip a harder block
# The exact UA matters: TikTok hard-blocks "Chrome/124.0.0.0" but serves
# "Chrome/124.0". Override only if the default stops working.
# TIKTOK_USER_AGENT=
